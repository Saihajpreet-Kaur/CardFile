# Server
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# JSON file storage
DATA_DIR=storage

# Upload limits
MAX_CSV_SIZE_MB=2
MAX_IMAGE_SIZE_MB=2
MAX_IMPORT_ROWS=1000

# Cloudinary - when empty, contact photos are saved to ./uploads in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script accounts
SEED_ADMIN_EMAIL=admin@crm.test
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_EMAIL=demo@crm.test
SEED_USER_PASSWORD=Demo@1234
